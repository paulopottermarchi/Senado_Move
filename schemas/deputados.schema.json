{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deputados",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": true,
    "required": ["id", "nome", "partido", "uf", "urlFoto"],
    "properties": {
      "id": { "type": "integer" },
      "nome": { "type": "string" },
      "partido": { "type": "string" },
      "federacao": { "type": ["string", "null"] },
      "uf": { "type": "string", "minLength": 2, "maxLength": 2 },
      "urlFoto": { "type": "string", "format": "uri" },
      "url": { "type": ["string", "null", "uri"] },
      "score": { "type": ["number", "null"] },
      "ideologia": { "type": ["string", "null"] },
      "ideX": { "type": ["number", "null"] }
    }
  }
}
