{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Consultas públicas do e-Cidadania",
  "type": "object",
  "required": ["_fonte", "_url", "_ligacao", "_aviso"],
  "properties": {
    "_fonte": { "type": "string", "minLength": 1 },
    "_url": { "type": "string", "format": "uri-template" },
    "_ligacao": { "type": "string", "minLength": 1 },
    "_aviso": { "type": "string", "minLength": 1 }
  },
  "patternProperties": {
    "^[0-9]+$": {
      "type": "object",
      "required": [
        "situacao",
        "consultadaEm",
        "codigoMateria",
        "identificacao",
        "confirmacao"
      ],
      "properties": {
        "sim": { "type": "integer", "minimum": 0 },
        "nao": { "type": "integer", "minimum": 0 },
        "situacao": {
          "enum": ["aberta", "encerrada", "sem página"]
        },
        "consultadaEm": { "type": "string", "format": "date" },
        "codigoMateria": { "type": "integer", "minimum": 1 },
        "identificacao": { "type": "string", "minLength": 1 },
        "confirmacao": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "situacao": { "enum": ["aberta", "encerrada"] }
            },
            "required": ["situacao"]
          },
          "then": { "required": ["sim", "nao"] }
        }
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
