{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Legislaturas",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": true,
    "required": ["id", "inicio", "fim"],
    "properties": {
      "id": { "type": "integer" },
      "inicio": { "type": "string", "format": "date" },
      "fim": { "type": ["string", "null", "date"] }
    }
  }
}
