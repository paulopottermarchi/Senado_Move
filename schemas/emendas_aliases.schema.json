{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aliases de autor de emenda (entradas/emendas_aliases.json)",
  "description": "Tabela curada lida por scripts/emendas_obras.py: código de autor da CGU gravado com mais de uma grafia para o mesmo deputado. Cada entrada traz a evidência e a data da conferência.",
  "type": "object",
  "additionalProperties": false,
  "required": ["aliases"],
  "properties": {
    "_leia": { "type": "string" },
    "aliases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["codigoAutor", "deputado", "grafias", "evidencia", "conferidoEm"],
        "properties": {
          "codigoAutor": { "type": "string", "pattern": "^[0-9]+$" },
          "deputado": { "type": "integer", "minimum": 1 },
          "nomeNaCamara": { "type": "string", "minLength": 1 },
          "grafias": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "evidencia": { "type": "string", "minLength": 1 },
          "conferidoEm": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
        }
      }
    }
  }
}
