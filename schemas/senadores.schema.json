{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Senadores",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": true,
    "required": ["id", "nome", "partido", "uf", "urlFoto", "url"],
    "properties": {
      "id": { "type": "integer" },
      "nome": { "type": "string" },
      "partido": { "type": "string" },
      "uf": { "type": "string", "minLength": 2, "maxLength": 2 },
      "urlFoto": { "type": "string", "format": "uri" },
      "url": { "type": "string", "format": "uri" }
    }
  }
}
