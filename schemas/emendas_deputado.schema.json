{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Emendas de deputados nas obras: arquivo de um deputado (site/dados/emendas/{id}.json)",
  "description": "Gerado por scripts/emendas_obras.py. Só o que o perfil mostra: nenhum campo de situação da obra, aditivo, crescimento do contrato ou valor somado por deputado (additionalProperties false em todos os níveis).",
  "type": "object",
  "additionalProperties": false,
  "required": ["_versao", "_uf", "_texto", "_notaValores", "_regras", "_empenhosDe", "deputado", "itens"],
  "properties": {
    "_versao": { "type": "string", "pattern": "^emendas-[0-9]+$" },
    "_uf": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "_texto": { "type": "string", "minLength": 1 },
    "_notaValores": { "type": "string", "minLength": 1 },
    "_regras": { "type": "string", "minLength": 1 },
    "_empenhosDe": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "deputado": { "type": "integer", "minimum": 1 },
    "grafiasCgu": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["codigo", "grafias"],
        "properties": {
          "codigo": { "type": "string", "pattern": "^[0-9]+$" },
          "grafias": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "itens": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/item" } }
  },
  "$defs": {
    "obra": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}-[0-9]{2}$" },
    "codigo": { "type": "string", "pattern": "^[0-9]{12}$" },
    "empenhos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "prefixItems": [
          { "type": "integer", "minimum": 100000, "maximum": 999999 },
          { "type": "string", "pattern": "^[0-9]{4}NE[0-9]{6}$" }
        ]
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "obra", "nome", "municipios", "noSite", "ano", "codigo", "empenhado", "emendaEmpenhado", "emendaPago", "empenhos"],
      "properties": {
        "id": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}-[0-9]{2}:[0-9]{12}$" },
        "obra": { "$ref": "#/$defs/obra" },
        "nome": { "type": "string", "minLength": 1, "maxLength": 200 },
        "municipios": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "noSite": { "type": "boolean" },
        "ano": { "type": "string", "pattern": "^[0-9]{4}$" },
        "codigo": { "$ref": "#/$defs/codigo" },
        "empenhado": { "type": "number", "exclusiveMinimum": 0 },
        "emendaEmpenhado": { "type": ["number", "null"], "minimum": 0 },
        "emendaPago": { "type": ["number", "null"], "minimum": 0 },
        "empenhos": { "$ref": "#/$defs/empenhos" }
      }
    }
  }
}
