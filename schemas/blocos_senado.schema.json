{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Blocos de voto do Senado",
  "type": "object",
  "required": [
    "_gerado",
    "_fonte",
    "casa",
    "votacoes",
    "votacoesComOrientacao",
    "regras",
    "corte",
    "blocos",
    "medianaGovernoPorPartido",
    "nomes",
    "deputados",
    "improvaveis",
    "improvaveisTotal",
    "temas",
    "temasLeis",
    "temasSemCategoria"
  ],
  "properties": {
    "_gerado": { "type": "string", "format": "date" },
    "_fonte": { "type": "string", "minLength": 1 },
    "casa": { "const": "senado" },
    "votacoes": { "type": "integer", "minimum": 0 },
    "votacoesComOrientacao": { "type": "integer", "minimum": 0 },
    "regras": { "type": "object" },
    "corte": { "type": "object" },
    "blocos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["n", "partidos", "medianaGoverno"],
        "properties": {
          "n": { "type": "integer", "minimum": 0 },
          "partidos": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 0 }
          },
          "medianaGoverno": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": true
      }
    },
    "medianaGovernoPorPartido": {
      "type": "object",
      "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "nomes": { "type": "object" },
    "deputados": { "type": "object" },
    "improvaveis": { "type": "array" },
    "improvaveisTotal": { "type": "integer", "minimum": 0 },
    "trocaramDePartido": { "type": "integer", "minimum": 0 },
    "temas": { "type": "array" },
    "temasLeis": { "type": "integer", "minimum": 0 },
    "temasSemCategoria": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": true
}
